# RedFace Connect — local development
# Copy to .env.local (never commit .env.local)
#
#   cp env/development.env.example .env.local
#
# Or pull from Vercel after linking the project:
#
#   vercel link
#   vercel env pull .env.local --environment=development

# ── Supabase (dedicated Connect project recommended) ─────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_CONNECT_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only — API routes (lead submit, assign, partners). Never expose in browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Admin access ─────────────────────────────────────────────────────────────
# Comma-separated emails that can use /dashboard (also set in Supabase connect_profiles)
CONNECT_ADMIN_EMAILS=info@redfacepay.co.za

# ── App URL (local) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
