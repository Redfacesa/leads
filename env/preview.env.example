# Supabase — use Connect staging project OR same as prod with caution
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_CONNECT_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — Preview
SUPABASE_SERVICE_ROLE_KEY=

CONNECT_ADMIN_EMAILS=info@redfacepay.co.za

# Preview deployment URL (Vercel sets VERCEL_URL automatically; override if using custom preview domain)
NEXT_PUBLIC_APP_URL=https://redface-connect-git-preview-redfacesa.vercel.app
