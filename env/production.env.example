# RedFace Connect — Vercel PRODUCTION
# Import in Vercel: Project → Settings → Environment Variables
# Scope: Production only
#
# Required before go-live:
# 1. Supabase Auth → URL configuration → add https://connect.redfacepay.co.za/auth/callback
# 2. Apply migrations: npx supabase db push --linked
# 3. Create auth user for info@redfacepay.co.za
#
# CLI (after vercel link):
#   vercel env add NEXT_PUBLIC_SUPABASE_URL production
#   vercel env add NEXT_PUBLIC_SUPABASE_ANON_KEY production
#   vercel env add SUPABASE_SERVICE_ROLE_KEY production
#   vercel env add CONNECT_ADMIN_EMAILS production
#   vercel env add NEXT_PUBLIC_APP_URL production

# ── Supabase (Connect production project) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_CONNECT_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER add to NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin ────────────────────────────────────────────────────────────────────
CONNECT_ADMIN_EMAILS=info@redfacepay.co.za

# ── Canonical production URL ───────────────────────────────────────────────────
# Primary: connect.redfacepay.co.za (add domain in Vercel → Domains)
NEXT_PUBLIC_APP_URL=https://connect.redfacepay.co.za
