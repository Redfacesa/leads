# RedFace Connect — environment variables (all environments)
# See env/development.env.example | env/preview.env.example | env/production.env.example
#
# Quick start (local):
#   cp env/development.env.example .env.local
#
# Pull from Vercel (after vercel link):
#   npm run env:pull          # development
#   npm run env:pull:preview
#   npm run env:pull:production

# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard access (comma-separated)
CONNECT_ADMIN_EMAILS=info@redfacepay.co.za

# Public app origin (consent links, auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
